{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/newo-ether/blender-mcp/schemas/node-layout-v1.json",
  "title": "Blender node layout measurement",
  "type": "object",
  "required": ["schema", "tree_ref", "revision", "tree", "scope", "stats", "measurement"],
  "properties": {
    "schema": {"const": "blender-node-layout/1"},
    "tree_ref": {"type": "object", "required": ["tree_type", "owner"]},
    "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {"type": "object", "properties": {"kind": {"const": "full"}}, "required": ["kind"]},
    "stats": {"type": "object", "required": ["node_count", "total_node_count", "link_count"]},
    "measurement": {
      "type": "object",
      "required": ["units", "ui_scale", "refreshed", "source_revision_excludes_measurements", "socket_positions_available"],
      "properties": {
        "units": {"const": "canvas"},
        "ui_scale": {"type": "number", "minimum": 0, "description": "Zero in headless Blender means UI scale is unavailable; no measured bounds are inferred."},
        "refreshed": {"type": "boolean"},
        "source_revision_excludes_measurements": {"const": true},
        "socket_positions_available": {"const": false}
      }
    },
    "tree": {
      "type": "object", "required": ["name", "nodes", "links"],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "required": ["name", "bl_idname", "layout"],
            "properties": {
              "layout": {
                "type": "object", "required": ["parent", "location", "absolute_location", "bounds", "bounds_status"],
                "properties": {
                  "parent": {"type": ["string", "null"]},
                  "location": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                  "absolute_location": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                  "bounds": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}]},
                  "bounds_status": {"enum": ["refreshed", "cached", "estimated", "unavailable"]}
                }
              }
            }
          }
        },
        "links": {"type": "array", "items": {"type": "object", "required": ["from_node", "from_socket", "to_node", "to_socket"]}}
      }
    }
  }
}
